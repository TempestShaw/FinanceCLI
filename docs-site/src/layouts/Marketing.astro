---
import "../styles/brand.css";
import Nav from "../components/marketing/Nav.astro";
import Footer from "../components/marketing/Footer.astro";
import { href } from "../lib/showcase";

interface Props { title: string; description: string; image?: string }
const { title, description, image = href("videos/apple-services.jpg") } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fafaf8" />
    <script is:inline>
      // Share the docs' theme choice (Starlight stores it under this key).
      try {
        const theme = localStorage.getItem("starlight-theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body class="fc">
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      // Copy buttons: <button data-copy="#target"> copies the target's text.
      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
        const label = button.textContent;
        button.addEventListener("click", async () => {
          const target = document.querySelector(button.dataset.copy!);
          try {
            await navigator.clipboard.writeText(target?.textContent?.trim() ?? "");
            button.textContent = "Copied";
          } catch {
            button.textContent = "Select & copy";
          }
          setTimeout(() => { button.textContent = label; }, 1800);
        });
      });
    </script>
    <style>
      .skip { position: absolute; left: -999px; top: 0; padding: .6rem 1rem; background: var(--accent); color: var(--accent-ink); z-index: 100; border-radius: 0 0 8px 0; }
      .skip:focus { left: 0; }
    </style>
  </body>
</html>
