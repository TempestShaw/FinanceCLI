---
import { videoFor, href, SHORT_TITLES, type ShowcaseCase } from "../../lib/showcase";
interface Props { item: ShowcaseCase; featured?: boolean }
const { item, featured = false } = Astro.props;
const { poster } = videoFor(item.slug);
---
<a class:list={["case", { featured }]} href={href(`showcase/${item.slug}/`)}>
  <div class="thumb">
    <img src={poster} alt="" loading="lazy" width="1920" height="1080" />
    <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg></span>
  </div>
  <div class="text">
    <p class="eyebrow">{item.kicker}</p>
    <h3>“{item.question.split(/(?<=[?.])\s/)[0]}”</h3>
    <p class="headline">{item.headline}</p>
    <span class="meta">{SHORT_TITLES[item.slug]} · {item.trace.length} steps <span aria-hidden="true">→</span></span>
  </div>
</a>
<style>
  .case { display: flex; flex-direction: column; text-decoration: none; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; transition: border-color .15s ease; }
  .case:hover { border-color: var(--ink); }
  .thumb { position: relative; aspect-ratio: 16 / 9; background: var(--surface-2); overflow: hidden; border-bottom: 1px solid var(--line); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .play { position: absolute; left: .8rem; bottom: .8rem; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: var(--accent-ink); }
  .text { padding: 1.2rem 1.3rem 1.3rem; display: flex; flex-direction: column; gap: .55rem; flex: 1; }
  h3 { margin: 0; font: 600 1.18rem/1.3 var(--font-serif); letter-spacing: -.01em; }
  .headline { margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.55; flex: 1; }
  .meta { font-size: .76rem; color: var(--faint); }
  .featured { display: grid; grid-template-columns: 1.35fr 1fr; }
  .featured .thumb { aspect-ratio: auto; min-height: 100%; border-bottom: 0; border-right: 1px solid var(--line); }
  .featured h3 { font-size: 1.55rem; }
  .featured .text { padding: 2rem; justify-content: center; }
  @media (max-width: 820px) { .featured { display: flex; } .featured .thumb { aspect-ratio: 16 / 9; border-right: 0; border-bottom: 1px solid var(--line); } .featured .text { padding: 1.2rem 1.3rem 1.3rem; } }
</style>
