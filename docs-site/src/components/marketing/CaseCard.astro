---
import { videoFor, href, SHORT_TITLES, type ShowcaseCase } from "../../lib/showcase";
interface Props { item: ShowcaseCase; featured?: boolean }
const { item, featured = false } = Astro.props;
const { poster } = videoFor(item.slug);
---
<a class:list={["case", { featured }]} href={href(`showcase/${item.slug}/`)}>
  <div class="thumb">
    <img src={poster} alt="" loading="lazy" width="1920" height="1080" />
    <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg></span>
  </div>
  <div class="text">
    <p class="eyebrow">{item.kicker}</p>
    <h3>“{item.question.split(/(?<=[?.])\s/)[0]}”</h3>
    <p class="headline">{item.headline}</p>
    <span class="meta">{SHORT_TITLES[item.slug]} · {item.trace.length} steps <span aria-hidden="true">→</span></span>
  </div>
</a>
<style>
  .case { display: flex; flex-direction: column; text-decoration: none; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden;
    box-shadow: var(--shadow); transition: transform .2s ease, border-color .2s ease; }
  .case:hover { transform: translateY(-3px); border-color: var(--line-strong); }
  .thumb { position: relative; aspect-ratio: 16 / 9; background: #0b1511; overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .case:hover .thumb img { transform: scale(1.025); }
  .play { position: absolute; left: 1rem; bottom: 1rem; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--lime); color: #0b1511; }
  .text { padding: 1.3rem 1.4rem 1.4rem; display: flex; flex-direction: column; gap: .6rem; flex: 1; }
  h3 { margin: 0; font-size: 1.15rem; line-height: 1.3; letter-spacing: -.02em; font-weight: 620; }
  .headline { margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.55; flex: 1; }
  .meta { font: .72rem var(--font-mono); color: var(--faint); }
  .featured { display: grid; grid-template-columns: 1.35fr 1fr; }
  .featured .thumb { aspect-ratio: auto; min-height: 100%; }
  .featured h3 { font-size: 1.45rem; }
  .featured .text { padding: 2rem; justify-content: center; }
  @media (max-width: 820px) { .featured { display: flex; } .featured .thumb { aspect-ratio: 16 / 9; } .featured .text { padding: 1.3rem 1.4rem 1.4rem; } }
</style>
