---
import { videoFor, recordedOn } from "../../lib/showcase";
interface Props { slug: string; label: string; caption?: string; eager?: boolean }
const { slug, label, caption, eager = false } = Astro.props;
const { src, poster } = videoFor(slug);
---
<figure class="player" data-player>
  <div class="chrome"><span>Recorded agent session</span><span>{recordedOn} · real CLI output</span></div>
  <div class="screen">
    <video src={src} poster={poster} preload="none" playsinline controls aria-label={label} width="1920" height="1080"></video>
    <button class="play" type="button" data-play aria-label={`Play: ${label}`}>
      <span class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg></span>
      <span class="text">{label}</span>
    </button>
    {eager && <link rel="preload" as="image" href={poster} />}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<script>
  document.querySelectorAll<HTMLElement>("[data-player]").forEach((player) => {
    const video = player.querySelector("video")!;
    const play = player.querySelector<HTMLButtonElement>("[data-play]")!;
    video.controls = false;
    play.addEventListener("click", () => {
      video.controls = true;
      play.hidden = true;
      void video.play();
    });
    video.addEventListener("ended", () => { play.hidden = false; });
  });
</script>
<style>
  .player { margin: 0; border: 1px solid var(--line-strong); border-radius: var(--radius); overflow: hidden; background: var(--surface); }
  .chrome { display: flex; justify-content: space-between; gap: 1rem; padding: .55rem .9rem; border-bottom: 1px solid var(--line); font: 600 .7rem/1.4 var(--font-sans); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .chrome span:last-child { font-weight: 500; text-transform: none; letter-spacing: 0; color: var(--faint); }
  .screen { position: relative; aspect-ratio: 16 / 9; background: var(--surface-2); }
  video { width: 100%; height: 100%; object-fit: cover; }
  .play { position: absolute; left: clamp(.8rem, 2vw, 1.4rem); bottom: clamp(.8rem, 2vw, 1.4rem); display: inline-flex; align-items: center; gap: .7rem; padding: .6rem 1rem .6rem .6rem;
    border: 1px solid var(--line-strong); border-radius: 999px; background: var(--surface); color: var(--ink); cursor: pointer; font: 600 .88rem var(--font-sans); box-shadow: 0 6px 20px -8px #0003; }
  .play[hidden] { display: none; }
  .icon { width: 34px; height: 34px; flex: none; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: var(--accent-ink); }
  .icon svg { width: 18px; height: 18px; }
  .play:hover { border-color: var(--ink); }
  figcaption { padding: .7rem .9rem; font-size: .8rem; color: var(--muted); border-top: 1px solid var(--line); }
</style>
