---
import { href } from "../../lib/showcase";
const path = Astro.url.pathname;
const links = [
  { label: "Showcase", to: href("showcase/") },
  { label: "AI setup", to: href("ai/") },
  { label: "Docs", to: href("quickstart/") },
];
---
<header class="nav night">
  <nav class="wrap" aria-label="Main">
    <a class="brand" href={href("")} aria-label="Finance CLI home"><span class="mark" aria-hidden="true">ƒ</span>Finance CLI</a>
    <div class="links">
      {links.map((l) => <a href={l.to} aria-current={path.startsWith(l.to) ? "page" : undefined}>{l.label}</a>)}
      <a class="gh" href="https://github.com/TempestShaw/FinanceCLI">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </nav>
</header>
<style>
  .nav { position: sticky; top: 0; z-index: 50; background: #0b1511e6; backdrop-filter: blur(12px); border-bottom: 1px solid #24382f; }
  nav { height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .brand { display: flex; align-items: center; gap: .65rem; font-weight: 700; letter-spacing: -.03em; font-size: 1.08rem; text-decoration: none; white-space: nowrap; }
  .mark { width: 30px; height: 30px; border-radius: 8px; display: grid; place-items: center; background: var(--lime); color: #0b1511; font: italic 1.45rem/1 var(--font-serif); }
  .links { display: flex; align-items: center; gap: clamp(.8rem, 2.4vw, 1.8rem); font-size: .9rem; }
  .links a { text-decoration: none; color: var(--night-muted); }
  .links a:hover, .links a[aria-current="page"] { color: var(--night-ink); }
  .gh { border: 1px solid #36503f; padding: .42rem .75rem; border-radius: 8px; color: var(--night-ink) !important; }
  @media (max-width: 560px) { .links { font-size: .8rem; gap: .75rem; } .gh { display: none; } .brand { font-size: .98rem; } }
</style>
