---
import { href } from "../../lib/showcase";
const path = Astro.url.pathname;
const links = [
  { label: "Showcase", to: href("showcase/") },
  { label: "AI setup", to: href("ai/") },
  { label: "Docs", to: href("quickstart/") },
];
---
<header class="nav">
  <nav class="wrap" aria-label="Main">
    <a class="brand" href={href("")} aria-label="Finance CLI home"><span class="mark" aria-hidden="true">ƒ</span>Finance CLI</a>
    <div class="links">
      {links.map((l) => <a href={l.to} aria-current={path.startsWith(l.to) ? "page" : undefined}>{l.label}</a>)}
      <a class="gh" href="https://github.com/TempestShaw/FinanceCLI">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </nav>
</header>
<style>
  .nav { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  nav { height: 60px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .brand { display: flex; align-items: center; gap: .6rem; font-weight: 700; letter-spacing: -.02em; font-size: 1.02rem; text-decoration: none; white-space: nowrap; color: var(--ink); }
  .mark { width: 26px; height: 26px; border-radius: 4px; display: grid; place-items: center; background: var(--ink); color: var(--bg); font: 600 1.05rem/1 var(--font-serif); font-style: italic; }
  .links { display: flex; align-items: center; gap: clamp(.8rem, 2.4vw, 1.8rem); font-size: .88rem; }
  .links a { text-decoration: none; color: var(--muted); }
  .links a:hover, .links a[aria-current="page"] { color: var(--ink); }
  .gh { border: 1px solid var(--line-strong); padding: .38rem .7rem; border-radius: var(--radius); color: var(--ink) !important; }
  @media (max-width: 560px) { .links { font-size: .8rem; gap: .75rem; } .gh { display: none; } .brand { font-size: .95rem; } }
</style>
