---
import type { TraceStep } from "../../lib/showcase";
interface Props { steps: TraceStep[]; compact?: boolean }
const { steps, compact = false } = Astro.props;
---
<ol class:list={["trace", { compact }]}>
  {steps.map((s, i) => (
    <li class:list={{ gap: Boolean(s.note) }}>
      <span class="n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
      <div class="body">
        <div class="head"><code class="tool">{s.tool}</code><span class="purpose">{s.purpose}</span></div>
        {!compact && <code class="cmd">{s.command}</code>}
        <p class="result"><span aria-hidden="true">→ </span>{s.result}</p>
        {s.note && <p class="note"><b>Gap found:</b> {s.note.replace(/^Gap found:\s*/, "")}</p>}
        {!compact && s.evidence && <a class="ev" href={s.evidence}>Raw CLI output ↗</a>}
      </div>
    </li>
  ))}
</ol>
<style>
  .trace { list-style: none; margin: 0; padding: 0; position: relative; }
  .trace::before { content: ""; position: absolute; left: 1.05rem; top: .5rem; bottom: .5rem; width: 1px; background: var(--line); }
  li { position: relative; display: grid; grid-template-columns: 2.1rem 1fr; gap: 1rem; padding: .85rem 0; }
  .n { position: relative; z-index: 1; width: 2.1rem; height: 2.1rem; border-radius: 50%; display: grid; place-items: center; background: var(--surface); border: 1px solid var(--line-strong);
    font: 500 .68rem var(--font-mono); color: var(--accent); }
  .gap .n { border-color: var(--warn); color: var(--warn); }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; gap: .35rem .8rem; }
  .tool { font-size: .8rem; color: var(--accent); background: var(--accent-soft); padding: .15rem .45rem; border-radius: 5px; }
  .purpose { font-weight: 550; font-size: .95rem; }
  .cmd { display: block; margin-top: .45rem; font-size: .72rem; color: var(--faint); overflow-wrap: anywhere; }
  .result { margin: .35rem 0 0; color: var(--muted); font-size: .88rem; }
  .note { margin: .5rem 0 0; font-size: .85rem; color: var(--warn); }
  .ev { display: inline-block; margin-top: .35rem; font-size: .74rem; color: var(--accent); }
  .compact li { padding: .55rem 0; }
  .compact .purpose { font-size: .88rem; }
</style>
