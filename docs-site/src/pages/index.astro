---
import Marketing from "../layouts/Marketing.astro";
import VideoPlayer from "../components/marketing/VideoPlayer.astro";
import ArtifactWindow from "../components/marketing/ArtifactWindow.astro";
import CaseCard from "../components/marketing/CaseCard.astro";
import CopyBlock from "../components/marketing/CopyBlock.astro";
import { cases, caseBySlug, href, recordedOn } from "../lib/showcase";

const apple = caseBySlug("apple-services");
const gap = caseBySlug("data-gap");
const [featured, ...rest] = cases;
const pitfalls = [
  { title: "Mixed fiscal years", risk: "Apple’s year ends in September, NVIDIA’s in January. Blend them and the comparison is quietly wrong.", keep: "Every value keeps its period end date." },
  { title: "Million vs billion", risk: "Statements, notes and websites scale numbers differently. One slip changes the answer by 1,000×.", keep: "Raw XBRL values, with the unit stated." },
  { title: "Restated history", risk: "Later filings can revise earlier years. A copied number may no longer be the reported one.", keep: "Overlapping years cross-checked across filings." },
  { title: "Mystery numbers", risk: "A ratio with no inputs can’t be checked, so it can’t be trusted.", keep: "Calculations return inputs and method." },
];
---
<Marketing title="Finance CLI — financial research tools for AI agents" description="Give your AI agent tools to retrieve SEC filings, normalize financial data, calculate metrics and keep the source behind every number. Watch five recorded research sessions.">
  <section class="hero night" aria-labelledby="hero-title">
    <div class="wrap cover">
      <div class="cover-text">
        <p class="eyebrow">Financial research tools for AI agents</p>
        <h1 id="hero-title" class="display">Your AI can browse financial data. <span class="serif">Can you verify its answer?</span></h1>
        <p class="lead">Finance CLI gives your agent tools to retrieve SEC filings, normalize periods and units, calculate metrics, and keep the source behind every important number. You ask the question. Your agent decides how to investigate it.</p>
        <div class="actions">
          <a class="btn btn-primary" href="#start">Run your first research task <span aria-hidden="true">→</span></a>
          <a class="btn btn-ghost" href={href("showcase/")}>Read the five case studies</a>
        </div>
        <div class="install"><code id="install-cmd">pip install finresearch-cli</code><button class="copy-btn" type="button" data-copy="#install-cmd">Copy</button></div>
        <p class="fine">Open source · Runs locally · SEC research needs no paid key</p>
      </div>
      <figure class="exhibit card">
        <figcaption><span>Exhibit 1</span>Apple — Services share of net sales</figcaption>
        <table>
          <thead><tr><th scope="col">Fiscal year</th><th scope="col" class="end">Services</th><th scope="col" class="end">Share</th><th scope="col" class="bar-col"><span class="sr">Share chart</span></th></tr></thead>
          <tbody>
            {apple.table!.rows.map((r) => (
              <tr><td><a href={r.url}>{r.fy}</a></td><td class="end">{r.services}</td><td class="end"><b>{r.share}</b></td>
                <td class="bar-col"><span class="bar" style={`width:${parseFloat(r.share) / 30 * 100}%`}></span></td></tr>
            ))}
          </tbody>
        </table>
        <p class="note">Source: Apple Form 10-K filings, FY2022 and FY2025 (fiscal years end in late September). Values reported in $ millions; share = Services ÷ net sales. Each year links to its filing. Retrieved by an agent with Finance CLI on {recordedOn}.</p>
      </figure>
    </div>
  </section>

  <section class="section watch" id="demo" aria-labelledby="demo-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">How Exhibit 1 was made</p>
          <h2 id="demo-title" class="h2">Watch the agent build it, <span class="serif">one tool call at a time.</span></h2>
        </div>
        <p class="lead">Seven CLI calls: find the filings, read the statements, check overlapping years for restatements, confirm units, and calculate. Sixty seconds, no editing of the numbers.</p>
      </div>
      <VideoPlayer slug="apple-services" label="Play the 60-second session" eager caption={`“Has Apple become more dependent on Services?” — 7 CLI calls, 6 fiscal years, every figure linked to its 10-K.`} />
    </div>
  </section>

  <section class="section" aria-labelledby="artifact-title">
    <div class="wrap split">
      <div class="intro">
        <p class="eyebrow">The output</p>
        <h2 id="artifact-title" class="h2">Not a chatbot answer. <span class="serif">A research artifact.</span></h2>
        <p class="lead">This is what the agent produced in the video above, using real CLI output. Open each tab to see the evidence, the tool calls, the arithmetic, and what the filings don’t say.</p>
        <a class="text-link" href={href("showcase/apple-services/")}>Read the full Apple case study →</a>
      </div>
      <ArtifactWindow item={apple} />
    </div>
  </section>

  <section class="section alt night" aria-labelledby="why-title">
    <div class="wrap">
      <p class="eyebrow">Why not just let the agent browse?</p>
      <h2 id="why-title" class="h2">Browsing finds numbers.<br /><span class="serif">Research needs to know which number.</span></h2>
      <div class="pitfalls">
        {pitfalls.map((p) => (
          <article class="card">
            <h3>{p.title}</h3>
            <p class="risk">{p.risk}</p>
            <p class="keep"><span class="status good"><b aria-hidden="true">✓</b>Finance CLI</span> {p.keep}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="cases-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Showcase</p>
          <h2 id="cases-title" class="h2">Five research questions,<br /><span class="serif">start to finish.</span></h2>
        </div>
        <p class="lead">Each session is a real question answered from real filings. The tool calls, raw CLI output and calculations are published, so you can check every step or rerun it.</p>
      </div>
      <div class="cases">
        <CaseCard item={featured} featured />
        {rest.map((item) => <CaseCard item={item} />)}
      </div>
    </div>
  </section>

  <section class="section gap" aria-labelledby="gap-title">
    <div class="wrap gap-grid">
      <div>
        <p class="eyebrow">Missing data, reported honestly</p>
        <h2 id="gap-title" class="gap-quote">Sometimes the right answer is <span class="serif">“the filing doesn’t disclose that.”</span></h2>
        <p class="lead">Finance CLI helps agents tell missing data from zero, an undisclosed figure from a failed retrieval, and reported values from calculated ones.</p>
        <a class="btn btn-ghost" href={href("showcase/data-gap/")}>See how the agent checked <span aria-hidden="true">→</span></a>
      </div>
      <div class="gap-card">
        <p class="gq">“{gap.question}”</p>
        <dl>
          <div><dt class="ok">Available</dt><dd>{gap.gap!.available}</dd></div>
          <div><dt class="no">Missing</dt><dd>{gap.gap!.missing}</dd></div>
          <div><dt>Reason</dt><dd>{gap.gap!.reason}</dd></div>
        </dl>
        <p class="policy">{gap.gap!.policy}</p>
      </div>
    </div>
  </section>

  <section class="section" id="start" aria-labelledby="start-title">
    <div class="wrap">
      <p class="eyebrow">Get started</p>
      <h2 id="start-title" class="h2">Reproduce the Apple study <span class="serif">with your own agent.</span></h2>
      <p class="lead">You need an agent that can run terminal commands, such as Claude Code or Codex. Finance CLI runs locally; SEC research needs no paid key.</p>
      <ol class="steps">
        <li class="card">
          <span class="num">Step 1</span>
          <h3>Install the CLI</h3>
          <p>Python 3.10 or later. Then give SEC your name and email, as its fair-access policy asks.</p>
          <p class="os">macOS / Linux</p>
          <CopyBlock id="step-install" text={`python -m pip install -U finresearch-cli\nexport FINANCE_SEC_USER_AGENT="Your Name you@example.com"`} />
          <p class="os">Windows (PowerShell)</p>
          <CopyBlock id="step-install-win" text={`py -m pip install -U finresearch-cli\n$env:FINANCE_SEC_USER_AGENT="Your Name you@example.com"`} />
        </li>
        <li class="card">
          <span class="num">Step 2</span>
          <h3>Add the skill</h3>
          <p>It teaches your agent which tools to use and how to cite them. Paste this into your agent:</p>
          <CopyBlock id="step-skill" text="Download https://tempestshaw.github.io/FinanceCLI/skills/finance-cli-skills.zip, extract it, copy the skills/finance-cli folder into my local agent skills directory, and verify it contains SKILL.md." />
        </li>
        <li class="card">
          <span class="num">Step 3</span>
          <h3>Ask the question</h3>
          <p>Then compare its answer with the recorded session. {apple.metrics[0].label}: <b>{apple.metrics[0].value}</b>.</p>
          <p class="expect">Expect 5–10 minutes and 30–40 tool calls. Your agent will ask to run <code>finance</code> commands; allow them.</p>
          <CopyBlock id="step-ask" text={apple.prompt} />
        </li>
      </ol>
      <p class="more">Detailed setup for each agent: <a href={href("ai/")}>AI integration guide</a> · <a href={href("quickstart/")}>Quick start</a> · Or run the same tools yourself: <code>finance filings.statement AAPL statement=income --output md</code></p>
    </div>
  </section>
</Marketing>

<style>
  .hero { padding: clamp(3rem, 7vw, 5.5rem) 0; border-bottom: 1px solid var(--line); }
  .cover { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .actions { display: flex; flex-wrap: wrap; gap: .7rem; margin: 1.8rem 0 1.2rem; }
  .install { display: inline-flex; align-items: center; gap: .8rem; padding: .4rem .45rem .4rem .9rem; border: 1px solid var(--line-strong); border-radius: var(--radius); background: var(--surface); font-size: .84rem; }
  .install::before { content: "$"; color: var(--faint); font-family: var(--font-mono); }
  .install .copy-btn { position: static; }
  .fine { font-size: .8rem; color: var(--faint); margin: .9rem 0 0; }

  .exhibit { margin: 0; padding: 1.4rem 1.5rem 1.2rem; }
  .exhibit figcaption { font: 600 1.05rem/1.35 var(--font-serif); padding-bottom: .8rem; border-bottom: 2px solid var(--ink); }
  .exhibit figcaption span { display: block; font: 600 .7rem/1.4 var(--font-sans); letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin-bottom: .2rem; }
  .exhibit table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: .92rem; }
  .exhibit th { font: 600 .7rem/1.3 var(--font-sans); letter-spacing: .04em; text-transform: uppercase; color: var(--muted); text-align: left; padding: .6rem .4rem; border-bottom: 1px solid var(--line-strong); }
  .exhibit td { padding: .5rem .4rem; border-bottom: 1px solid var(--line); }
  .exhibit td a { color: var(--accent); }
  .exhibit .end { text-align: right; }
  .bar-col { width: 34%; }
  .bar { display: block; height: 8px; background: var(--accent); border-radius: 0 2px 2px 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .note { font-size: .74rem; line-height: 1.55; color: var(--faint); margin: .9rem 0 0; }

  .watch :global(.player) { margin-top: .5rem; }
  .split { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.4fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .intro { position: sticky; top: 5.5rem; }
  .text-link { display: inline-block; margin-top: 1.3rem; color: var(--accent); font-weight: 600; font-size: .92rem; }

  .pitfalls { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin-top: 2.2rem; border-top: 2px solid var(--ink); }
  .pitfalls article { padding: 1.3rem 1.3rem 1.3rem 0; display: flex; flex-direction: column; gap: .6rem; border: 0; border-radius: 0; background: transparent; }
  .pitfalls article + article { padding-left: 1.3rem; border-left: 1px solid var(--line); }
  .pitfalls h3 { margin: 0; font: 600 1.15rem/1.3 var(--font-serif); }
  .risk { margin: 0; color: var(--muted); font-size: .88rem; line-height: 1.6; flex: 1; }
  .keep { margin: 0; padding-top: .8rem; border-top: 1px solid var(--line); font-size: .86rem; display: flex; flex-direction: column; gap: .35rem; }

  .section-head { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: end; margin-bottom: 2.2rem; }
  .cases { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.1rem; }
  .cases :global(.featured) { grid-column: 1 / -1; }

  .gap-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .gap-quote { font: 600 clamp(1.9rem, 3.8vw, 3rem)/1.12 var(--font-serif); letter-spacing: -.015em; margin: .9rem 0 1.1rem; text-wrap: balance; }
  .gap .lead { margin-bottom: 1.6rem; }
  .gap-card { background: var(--surface); border: 1px solid var(--line); border-left: 3px solid var(--bad); border-radius: var(--radius); padding: clamp(1.2rem, 3vw, 1.8rem); font-size: .88rem; line-height: 1.6; }
  .gq { font: 600 1.15rem/1.4 var(--font-serif); margin: 0 0 1.1rem; }
  .gap-card dl { margin: 0; display: grid; gap: .6rem; }
  .gap-card dl div { display: grid; grid-template-columns: 6.5rem 1fr; gap: .8rem; padding-bottom: .6rem; border-bottom: 1px solid var(--line); }
  .gap-card dt { font: 600 .72rem/1.6 var(--font-sans); letter-spacing: .05em; text-transform: uppercase; color: var(--muted); }
  .gap-card dt.ok { color: var(--good); }
  .gap-card dt.no { color: var(--bad); }
  .gap-card dd { margin: 0; }
  .policy { margin: 1rem 0 0; font-weight: 600; }

  .steps { list-style: none; padding: 0; margin: 2.2rem 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .steps li { padding: 1.4rem; display: flex; flex-direction: column; gap: .65rem; min-width: 0; }
  .steps h3 { margin: 0; font: 600 1.15rem/1.3 var(--font-serif); }
  .steps p { margin: 0; color: var(--muted); font-size: .88rem; }
  .steps :global(pre) { max-height: 12.5rem; overflow: auto; }
  .os { font: 600 .7rem/1 var(--font-sans) !important; letter-spacing: .06em; text-transform: uppercase; color: var(--faint) !important; margin-top: .3rem !important; }
  .expect { font-size: .8rem !important; color: var(--faint) !important; }
  .expect code { font-size: .76rem; }
  .num { font: 600 .72rem/1 var(--font-sans); letter-spacing: .08em; text-transform: uppercase; color: var(--accent); }
  .more { margin-top: 1.5rem; font-size: .88rem; color: var(--muted); }
  .more a { color: var(--accent); }
  .more code { font-size: .78rem; background: var(--surface-2); padding: .12rem .35rem; border-radius: 3px; overflow-wrap: anywhere; }

  @media (max-width: 1000px) {
    .pitfalls { grid-template-columns: repeat(2, 1fr); }
    .pitfalls article:nth-child(3) { padding-left: 0; border-left: 0; }
    .pitfalls article:nth-child(n+3) { border-top: 1px solid var(--line); }
    .cover, .split, .gap-grid, .section-head { grid-template-columns: 1fr; }
    .intro { position: static; }
    .steps { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .pitfalls, .cases { grid-template-columns: 1fr; }
    .pitfalls article, .pitfalls article + article { padding: 1.1rem 0; border-left: 0; }
    .pitfalls article + article { border-top: 1px solid var(--line); }
    .install { max-width: 100%; }
    .install code { overflow-wrap: anywhere; font-size: .78rem; }
    .gap-card dl div { grid-template-columns: 1fr; gap: .1rem; }
  }
</style>
